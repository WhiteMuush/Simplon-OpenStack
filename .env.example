# Copy to .env and adjust. .env is gitignored, .env.example is not.

# Azure host VM
RG=mpetitRG
LOC=francecentral
VM=devstack
ADMIN=azureuser

# Dv5 is not available on the shared subscription, and the B series does not
# support nested virtualization. D4s_v4 is the safe choice.
SIZE=Standard_D4s_v4
DISK_GB=64

# Daily auto shutdown, UTC, safety net if a deallocate is forgotten
SHUTDOWN_TIME=2000

# Local port used to tunnel Horizon
HORIZON_PORT=8080
