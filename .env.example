# Copy to .env and adjust. .env is gitignored, .env.example is not.
# Host VM sizing lives in terraform/azure/terraform.tfvars, not here.

# Used by the billing targets and the SSH tunnel
RG=mpetitRG
VM=devstack
ADMIN=azureuser

# Local port the Horizon tunnel listens on
HORIZON_PORT=8080

# DevStack admin password, injected into local.conf by the playbook.
# Generate one with: openssl rand -base64 24
DEVSTACK_PASSWORD=
