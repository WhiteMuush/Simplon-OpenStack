# À copier sur la VM dans /opt/stack/devstack/local.conf
# HOST_IP doit être l'adresse PRIVEE de la VM, donnée par : ip -br addr
# Sur Azure, jamais l'adresse publique : elle n'existe pas sur l'interface.

[[local|localrc]]
ADMIN_PASSWORD=labpassword
DATABASE_PASSWORD=$ADMIN_PASSWORD
RABBIT_PASSWORD=$ADMIN_PASSWORD
SERVICE_PASSWORD=$ADMIN_PASSWORD

HOST_IP=10.0.0.4

# Sur une VM cloud, le réseau flottant reste interne : l'hébergeur ne route
# pas des adresses arbitraires. On garde la plage par défaut de DevStack.
FLOATING_RANGE=172.24.4.0/24

# Suite de tests très longue et inutile pour un lab.
disable_service tempest
disable_service swift

# À décommenter seulement si kvm-ok répond non.
#LIBVIRT_TYPE=qemu

LOGFILE=/opt/stack/logs/stack.sh.log
LOGDAYS=2
