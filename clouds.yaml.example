# À copier dans ~/.config/openstack/clouds.yaml puis chmod 600
# Le mot de passe est en clair : ce fichier ne va JAMAIS dans Git.
clouds:
  lab:
    auth:
      auth_url: http://127.0.0.1:8080/identity
      username: admin
      password: labpassword
      project_name: admin
      user_domain_name: Default
      project_domain_name: Default
    region_name: RegionOne
    interface: public
    identity_api_version: 3
