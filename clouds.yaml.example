# Copy to ~/.config/openstack/clouds.yaml then chmod 600.
# The password is stored in clear text: this file NEVER goes into Git.
clouds:
  lab:
    auth:
      auth_url: http://127.0.0.1:8080/identity
      username: admin
      password: labpassword
      project_name: admin
      user_domain_name: Default
      project_domain_name: Default
    region_name: RegionOne
    interface: public
    identity_api_version: 3
